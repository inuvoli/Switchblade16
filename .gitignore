# SwitchBlade 16 Firmware - Git Ignore File

# ============================================================
# Build Output Directories
# ============================================================
# These directories contain compiled artifacts that should not
# be version controlled. They are regenerated by build.cmd
# (Windows) or build.sh (Linux).

bin/
build/

# ============================================================
# Compiled Binary Files (in case they exist outside bin/build)
# ============================================================
*.bin
*.hex
*.ihx

# ============================================================
# SDCC Intermediate Files
# ============================================================
# SDCC generates various temporary files during compilation
*.asm
*.rel
*.lst
*.sym
*.rst
*.lk
*.map
*.mem
*.cod

# ============================================================
# Editor & IDE Files
# ============================================================
# Common editor backup and configuration files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ============================================================
# OS-Specific Files
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Documentation Build Artifacts (if applicable)
# ============================================================
docs/_build/
*.pdf

# ============================================================
# Notes
# ============================================================
# - Directories end with / to match only folders, not files
# - Patterns are relative to the repository root
# - Use 'git rm -r --cached <path>' to stop tracking already-committed files
